{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Simulation Config",
  "description": "The config for a simulation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stepsPerGen": {
      "$ref": "#/definitions/positiveInteger"
    },
    "populationSize": {
      "$ref": "#/definitions/positiveInteger"
    },
    "boardWidth": {
      "$ref": "#/definitions/positiveInteger"
    },
    "boardHeight": {
      "$ref": "#/definitions/positiveInteger"
    },
    "genes": {
      "$ref": "#/definitions/positiveInteger"
    },
    "maxInnerNeurons": {
      "$ref": "#/definitions/positiveInteger",
      "maximum": 128
    },
    "mutationRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "begin": {
            "$ref": "#/definitions/positiveInteger0"
          },
          "end": {
            "oneOf": [
              {
                "$ref": "#/definitions/positiveInteger"
              },
              {
                "const": -1
              }
            ]
          },
          "type": {
            "enum": [
              "DeathZone"
            ]
          },
          "args": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "regions": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "rect"
                            },
                            "x": {
                              "$ref": "#/definitions/length"
                            },
                            "y": {
                              "$ref": "#/definitions/length"
                            },
                            "width": {
                              "$ref": "#/definitions/length",
                              "minimum": 1
                            },
                            "height": {
                              "$ref": "#/definitions/length",
                              "minimum": 1
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "height",
                            "width",
                            "x",
                            "y"
                          ]
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "regions"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "begin",
          "end",
          "type",
          "args"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "genes",
    "boardHeight",
    "boardWidth",
    "maxInnerNeurons",
    "mutationRate",
    "populationSize",
    "stepsPerGen",
    "selection"
  ],
  "definitions": {
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "positiveInteger0": {
      "type": "integer",
      "minimum": 0
    },
    "length": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{1,2}%|100%$"
        },
        {
          "$ref": "#/definitions/positiveInteger0"
        }
      ]
    }
  }
}