{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Simulation Config",
  "description": "The config for a simulation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stepsPerGen": {
      "type": "integer",
      "minimum": 1
    },
    "populationSize": {
      "type": "integer",
      "minimum": 1
    },
    "boardWidth": {
      "type": "integer",
      "minimum": 1
    },
    "boardHeight": {
      "type": "integer",
      "minimum": 1
    },
    "genes": {
      "type": "integer",
      "minimum": 1
    },
    "maxInnerNeurons": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "mutationRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "begin": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": -1
          },
          "type": {
            "enum": [
              "DeathZone"
            ]
          },
          "args": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "regions": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "rect"
                            },
                            "x": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "y": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "width": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "height": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "height",
                            "width",
                            "x",
                            "y"
                          ]
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "regions"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "begin",
          "end",
          "type",
          "args"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "genes",
    "boardHeight",
    "boardWidth",
    "maxInnerNeurons",
    "mutationRate",
    "populationSize",
    "stepsPerGen",
    "selection"
  ]
}